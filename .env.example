APP_NAME=Evoriq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=evoriq
DB_USERNAME=postgres
DB_PASSWORD=

# Safe, dependency-free defaults so the app boots (and the /setup wizard can
# run) before Redis or the database is configured. Run
# `php artisan app:configure-drivers` (or complete the setup wizard) to switch
# to Redis automatically when it is reachable.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CRITICAL_TRIES=3
QUEUE_CRITICAL_TIMEOUT=60
QUEUE_DEFAULT_TRIES=5
QUEUE_DEFAULT_TIMEOUT=120
QUEUE_HEAVY_TRIES=1
QUEUE_HEAVY_TIMEOUT=1800

# Connection-level retry_after. Must be greater than the longest job timeout
# (QUEUE_HEAVY_TIMEOUT), otherwise long jobs are re-dispatched while still
# running and rejected with MaxAttemptsExceededException.
QUEUE_RETRY_AFTER=1860

# Allow super admins to run cache/config/route/view clearing and sync commands
# from Administration → Settings → Developer. Keep disabled in production.
DEVELOPER_MAINTENANCE_ACTIONS=false

HORIZON_PREFIX="${APP_NAME}_horizon"

EXPORT_DISK=local
EXPORT_BASE_PATH=exports
EXPORT_PAGINATION=15
EXPORT_CLEANUP_DAYS=7
EXPORT_IMPORT_CHUNK_SIZE=100
EXPORT_STALE_AFTER=1920

MEDIA_DISK=public

PULSE_ENABLED=true
TELESCOPE_ENABLED=true

SETANJO_CACHE_ENABLED=true

# Local development uses EnvKit mailpit (SMTP 1025, UI http://127.0.0.1:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@evoriq.test"
MAIL_FROM_NAME="${APP_NAME}"

# Remote object storage (AWS S3, Cloudflare R2, any S3-compatible).
# Configure through Administration -> Settings -> Remote storage; these keys
# are written by the storage settings UI. AWS_ENABLED=false keeps the remote
# disk out of the backup destinations.
AWS_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOCKIFY_API_URL=https://api.clockify.me/api/v1
CLOCKIFY_REPORTS_URL=https://reports.api.clockify.me/v1
CLOCKIFY_ADDON_API_URL=https://api.clockify.me/api/v1
CLOCKIFY_TIMEOUT=30
CLOCKIFY_RETRY_TIMES=3
CLOCKIFY_RETRY_SLEEP=1000
CLOCKIFY_RATE_LIMIT_RPS=50
CLOCKIFY_RATE_LIMIT_BURST=50
CLOCKIFY_RATE_LIMIT_COOLDOWN=0
CLOCKIFY_PAGE_SIZE=200
CLOCKIFY_MAX_PAGE_SIZE=5000

# Backups (spatie/laravel-backup). The schedule, destination disks and
# retention windows are managed through Administration -> Settings -> Backups;
# these keys are the config-level fallbacks. Backups always land on the local
# `backups` disk; enable "Also send backups to remote storage" in the settings
# to mirror them to the S3/R2 destination configured under Remote storage.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_AGE_DAYS=1
BACKUP_MAX_MB=5000
BACKUP_KEEP_DAYS=14
# Archives larger than this are emailed without attachment.
BACKUP_EMAIL_MAX_ATTACHMENT_MB=10
# Static recipients for the backup archive email (comma-separated). Only used
# when the "Email recipients" backup setting is empty.
BACKUP_EMAIL_TO=
# Seconds before pg_dump/mysqldump is killed while dumping the database.
DB_DUMP_TIMEOUT=900

VITE_APP_NAME="${APP_NAME}"
